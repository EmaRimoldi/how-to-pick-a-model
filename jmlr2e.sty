% jmlr2e.sty -- Minimal JMLR style (sufficient for draft compilation)
% Based on the JMLR proceedings style
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jmlr2e}[2024/01/01 Minimal JMLR style]

\RequirePackage{natbib}

% Page layout
\setlength{\textwidth}{6.5in}
\setlength{\textheight}{8.8in}
\setlength{\oddsidemargin}{0in}
\setlength{\evensidemargin}{0in}
\setlength{\topmargin}{-0.25in}
\setlength{\headheight}{14pt}
\setlength{\headsep}{20pt}

% Theorem environments
\RequirePackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{remark}[theorem]{Remark}
\newtheorem{example}[theorem]{Example}

% ShortHeadings command
\newcommand{\ShortHeadings}[2]{%
  \def\@shorttitle{#1}%
  \def\@shortauthors{#2}%
}

% firstpageno command
\newcommand{\firstpageno}[1]{\setcounter{page}{#1}}

% editor command
\newcommand{\editor}[1]{\def\@editor{#1}}

% addr command
\newcommand{\addr}{\\\small}

% keywords environment
\newenvironment{keywords}{\paragraph{Keywords:}}{}

% Set citation style
\bibpunct{[}{]}{,}{n}{,}{,}
\setcitestyle{numbers}
