# Copy this example to .env at the repository root and fill only the values
# needed by the selected experiment.
# Never commit .env.

# Required when the selected HumanEval+ router config uses codex_cli.
ROUTER_MODEL=

# Required only if router.backend is changed to openai_api.
OPENAI_API_KEY=

# Optional explicit-budget continuation pilot. The runner reads the process
# environment; it does not automatically load this file.
OPENROUTER_API_KEY=

# Optional ETA knobs used by long worker-run scripts.
EXPECTED_TOKENS_PER_ATTEMPT=350
TOKENS_PER_SECOND=35
EXPECTED_SECONDS_PER_EXAMPLE_1_5B=8
EXPECTED_SECONDS_PER_EXAMPLE_7B=22
EXPECTED_SECONDS_PER_EXAMPLE_32B=90
EXPECTED_SECONDS_PER_PROBLEM_15B=35
EXPECTED_SECONDS_PER_PROBLEM_7B=90
EXPECTED_SECONDS_PER_PROBLEM_32B=360
