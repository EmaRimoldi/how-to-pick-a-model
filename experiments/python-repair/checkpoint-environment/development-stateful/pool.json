      "id": "scrapy-026",
      "split": "development",
      "prefix": "import json\nimport copy\nimport warnings\nfrom collections.abc import MutableMapping\nfrom importlib import import_module\nfrom types import SimpleNamespace\n# Exact Python 3 semantics for the two six helpers used in these preserved definitions.\nsix = SimpleNamespace(string_types=(str,), iteritems=lambda mapping: iter(mapping.items()))\nclass ScrapyDeprecationWarning(Warning):\n    \"\"\"Warning category for deprecated features, since the default\n    DeprecationWarning is silenced on Python 2.7+\n    \"\"\"\n    pass\n\n\n",
      "wrappers": {
        "buggy": "def solve(defaults, base, updates):\n    component = BaseSettings(defaults, priority='default')\n    settings = BaseSettings({'COMPONENT': component})\n    if base is not None:\n        settings.set('COMPONENT_BASE', base, priority='project')\n    for key, value, priority in updates:\n        component.set(key, value, priority)\n    result = settings._getcomposite('COMPONENT')\n    return [[key, result[key], result.getpriority(key)] for key in sorted(result)]\n",
        "fixed": "def solve(defaults, base, updates):\n    component = BaseSettings(defaults, priority='default')\n    settings = BaseSettings({'COMPONENT': component})\n    if base is not None:\n        settings.set('COMPONENT_BASE', base, priority='project')\n    for key, value, priority in updates:\n        component.set(key, value, priority)\n    result = settings._getcomposite('COMPONENT')\n    return [[key, result[key], result.getpriority(key)] for key in sorted(result)]\n"
      },
      "instruction": "Repair the original priority-aware settings implementation. solve(defaults, base, updates) builds component defaults, optionally supplies an explicit base mapping, and applies [key,value,priority] updates. If base is supplied (including an empty dict), start from its entries at default priority and include component entries only when their stored priority is higher than default. Without a base, keep component defaults. Lower-priority updates must not replace higher-priority values; equal-priority updates replace earlier values. Priorities are default=0, command=10, project=20, spider=30, cmdline=40. Return sorted [key,value,priority] rows. Keys are strings, values are JSON scalars, and named priorities are valid. Preserve the interface and unrelated setting behavior.",
