      "prefix": "import shlex\nfrom shlex import quote\nfrom types import SimpleNamespace\n\n",
      "wrappers": {
        "buggy": "def solve(script):\n    command = SimpleNamespace(script=script, split_script=shlex.split(script))\n    return get_new_command(command)\n",
        "fixed": "def solve(script):\n    command = SimpleNamespace(script=script, split_script=shlex.split(script))\n    return get_new_command(command)\n"
      },
