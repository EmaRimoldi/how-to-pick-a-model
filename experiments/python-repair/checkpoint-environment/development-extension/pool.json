      "id": "luigi-003",
      "split": "development",
      "title": "Tuple literal parsing",
      "instruction": "Repair the tuple parser. For a textual Python tuple literal or JSON array containing numbers, or arrays/tuples of numeric sequences, parse the values and return solve(text) as an object with outer_type equal to tuple and value equal to the parsed sequence (nested tuples are serialized as JSON arrays). Preserve empty and nested sequences, negative numbers and decimal numbers. Non-sequence scalar input must raise TypeError; malformed non-literal text must raise ValueError. Scope excludes dictionaries, sets, null/booleans, strings as sequence members, and mixed nested/scalar sequences. You may edit helpers and classes in the supplied file; preserve the solve interface and stated behavior.",
      "prefix": "import json\nimport functools\nimport operator\nfrom ast import literal_eval\nfrom collections import OrderedDict\nfrom collections.abc import Mapping\n\nclass ListParameter:\n    pass\n\n",
      "wrappers": {
        "buggy": "def solve(text):\n    value = TupleParameter().parse(text)\n    return {\"outer_type\": type(value).__name__, \"value\": value}\n",
        "fixed": "def solve(text):\n    value = TupleParameter().parse(text)\n    return {\"outer_type\": type(value).__name__, \"value\": value}\n"
      },
      "public_cases": [
        {
          "id": "public-1",
          "args": [
            "(1, 2)"
          ],
          "expected": {
            "outer_type": "tuple",
            "value": [
              1,
              2
            ]
          }
        },
        {
          "id": "public-2",
          "args": [
            "[1, 2, 3]"
          ],
          "expected": {
            "outer_type": "tuple",
            "value": [
              1,
              2,
              3
            ]
          }
        },
        {
          "id": "public-3",
          "args": [
            "[[1,2],[3,4]]"
          ],
          "expected": {
            "outer_type": "tuple",
            "value": [
              [
                1,
                2
              ],
              [
                3,
                4
              ]
            ]
          }
        },
        {
          "id": "public-4",
          "args": [
            "()"
          ],
          "expected": {
            "outer_type": "tuple",
            "value": []
          }
        },
        {
          "id": "public-5",
          "args": [
            "[]"
          ],
          "expected": {
            "outer_type": "tuple",
            "value": []
          }
        },
        {
