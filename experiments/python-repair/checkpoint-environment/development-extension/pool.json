      "id": "thefuck-010",
      "split": "development",
      "title": "Manual-page suggestions",
      "instruction": "Repair manual-page suggestion construction. Inputs are valid POSIX man command strings and stderr text; this function returns suggestions and must never execute commands. Preserve existing explicit section switching: commands containing section 3 switch to 2, otherwise section 2 switches to 3. Without an explicit section, if stripped stderr is exactly No manual entry for followed by the last argument, return only [last_argument + \" --help\"]. Otherwise return the ordered list [\"man 3 \" + last_argument, \"man 2 \" + last_argument, last_argument + \" --help\"]. Scope: commands are man NAME or man with -s2/-s3/-s 2/-s 3/2/3 and NAME; NAME contains letters and underscores. Preserve the solve(script, stderr) interface. You may edit any supplied helper.",
      "prefix": "import shlex\nfrom types import SimpleNamespace\n\n",
      "wrappers": {
        "buggy": "def solve(script, stderr):\n    command = SimpleNamespace(script=script, stderr=stderr, script_parts=shlex.split(script))\n    return get_new_command(command)\n",
        "fixed": "def solve(script, stderr):\n    command = SimpleNamespace(script=script, stderr=stderr, script_parts=shlex.split(script))\n    return get_new_command(command)\n"
      },
      "public_cases": [
        {
