    {
      "id": "black-17",
      "split": "development",
      "prefix": "import io\nimport tokenize\nfrom typing import Tuple\nFileContent = Encoding = NewLine = str\n\n",
      "wrappers": {
        "buggy": "def solve(hex_bytes):\n    return decode_bytes(bytes.fromhex(hex_bytes))\n",
        "fixed": "def solve(hex_bytes):\n    return decode_bytes(bytes.fromhex(hex_bytes))\n"
      },
      "instruction": "Repair source-byte decoding. solve(hex_bytes) takes the hexadecimal encoding of Python source bytes and returns [decoded_text, encoding, newline]. Detect the encoding using the standard Python source-encoding rules, including BOM and encoding comments; decode with universal newline normalization. Report CRLF only if the first detected source line ends in CRLF, otherwise LF. Empty input and a UTF-8 BOM without source decode to empty text and use LF. Preserve ordinary encoded source behavior.",
      "public_cases": [
        {
          "id": "empty",
          "args": [
            ""
          ],
          "expected": [
            "",
            "utf-8",
            "\n"
          ]
        },
        {
          "id": "lf-source",
          "args": [
            "78203d20310a"
          ],
          "expected": [
            "x = 1\n",
            "utf-8",
            "\n"
          ]
        },
        {
          "id": "crlf-source",
          "args": [
            "78203d20310d0a"
          ],
          "expected": [
            "x = 1\n",
            "utf-8",
            "\r\n"
          ]
        },
        {
          "id": "bare-newline",
          "args": [
            "0a"
          ],
          "expected": [
            "\n",
            "utf-8",
            "\n"
          ]
        },
        {
          "id": "utf8-non-ascii",
          "args": [
            "2320636166c3a90a"
          ],
          "expected": [
            "# café\n",
            "utf-8",
            "\n"
          ]
        },
        {
          "id": "bom-source",
          "args": [
            "efbbbf78203d20320a"
          ],
          "expected": [
            "x = 2\n",
            "utf-8-sig",
            "\n"
          ]
        }
      ],
      "evaluator_cases": [
        {
          "id": "bom-only",
          "args": [
            "efbbbf"
          ],
          "expected": [
            "",
            "utf-8-sig",
