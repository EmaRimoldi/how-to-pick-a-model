    {
      "id": "tqdm-2",
      "split": "development",
      "prefix": "import re\n_unicode = str\n\n",
      "wrappers": {
        "buggy": "def solve(data, length):\n    return disp_trim(data, length)\n",
        "fixed": "def solve(data, length):\n    return disp_trim(data, length)\n"
      },
      "instruction": "Repair ANSI-aware display trimming. solve(data, length) returns the input trimmed to at most length visible columns (length is a nonnegative integer). Preserve complete ANSI controls and avoid duplicate reset codes when already present. If trimming leaves active ANSI codes, append one reset. Plain strings require no ANSI reset. Width follows the supplied helper: East Asian W/F characters have width two, other characters width one. Preserve already-fitting content. Inputs contain complete simple ANSI escape sequences and printable characters.",
      "public_cases": [
        {
          "id": "plain-truncation",
          "args": [
            "abcdef",
            3
          ],
          "expected": "abc"
        },
        {
          "id": "already-reset",
          "args": [
            "\u001b[31mabc\u001b[0m",
            3
          ],
          "expected": "\u001b[31mabc\u001b[0m"
        },
        {
          "id": "colored-truncation",
          "args": [
            "\u001b[31mabc",
            2
          ],
          "expected": "\u001b[31mab\u001b[0m"
        },
        {
          "id": "wide-character",
          "args": [
            "界x",
            2
          ],
          "expected": "界"
        },
        {
          "id": "empty",
          "args": [
            "",
            0
          ],
          "expected": ""
        },
        {
          "id": "reset-with-spare-width",
          "args": [
            "\u001b[1mA\u001b[0m",
            10
          ],
          "expected": "\u001b[1mA\u001b[0m"
        }
      ],
      "evaluator_cases": [
        {
          "id": "reset-only",
          "args": [
            "\u001b[0m",
            0
          ],
          "expected": "\u001b[0m"
        },
        {
          "id": "zero-width-plain",
          "args": [
            "12345",
            0
          ],
          "expected": ""
        },
        {
          "id": "two-wide",
          "args": [
            "界界x",
            4
          ],
          "expected": "界界"
        },
        {
          "id": "partial-wide",
          "args": [
            "界界x",
            3
          ],
          "expected": "界"
        },
        {
          "id": "empty-positive-width",
          "args": [
            "",
            3
          ],
          "expected": ""
        },
        {
          "id": "green-reset",
          "args": [
            "\u001b[32mZ\u001b[0m",
            20
          ],
          "expected": "\u001b[32mZ\u001b[0m"
        }
      ],
