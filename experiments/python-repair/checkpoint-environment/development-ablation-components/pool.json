      "id": "tqdm-4",
      "split": "development",
      "prefix": "import re\n_unich = chr\nRE_ANSI = re.compile(r\"\\x1b\\[[;\\d]*[A-Za-z]\")\n\nclass tqdm:\n",
      "wrappers": {
        "buggy": "def solve(parameters):\n    return tqdm.format_meter(**parameters)\n",
        "fixed": "def solve(parameters):\n    return tqdm.format_meter(**parameters)\n"
      },
      "instruction": "Repair the original progress-meter formatting. solve(parameters) forwards keyword arguments to format_meter. Preserve all existing formatting options. A numeric unit_scale other than 0 or 1 scales the iteration count and explicit rate, and scales the total only if a total exists. An absent, zero or overrun total means display progress statistics without a percentage or ETA. True/1 selects SI formatting. Inputs use valid format strings, nonnegative counts/time, positive numeric scales and finite optional rates.",
      "public_cases": [
        {
          "id": "scaled-unknown",
          "args": [
            {
              "n": 10,
              "total": null,
              "elapsed": 2,
              "unit_scale": 2
            }
          ],
          "expected": "20it [00:02, 10.00it/s]"
        },
        {
          "id": "scaled-empty",
          "args": [
            {
              "n": 0,
              "total": null,
              "elapsed": 0,
              "unit_scale": 3
            }
          ],
          "expected": "0it [00:00, ?it/s]"
        },
        {
