# Python environments, packages, and caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local secrets and editor/OS state
.env
.DS_Store
.vscode/
*.swp
*.tmp
*.bak

# Local Codex/Claude state. Shared agent definitions remain trackable.
.claude/logs/
.claude/settings.local.json
.claude/worktrees/

# Temporary and archival workspaces
tmp/
.local_archive/
paper/**/tmp/

# LaTeX build intermediates. Source PDFs remain trackable.
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.log
paper/**/*.out

# Runtime outputs that are not curated experiment evidence
runs/
studies/*/runs/
studies/*/logs/
autoresearch/data/

# Local run state and diagnostic output for benchmark bundles
experiments/**/data/raw/.*
experiments/**/data/raw/*.log
experiments/**/data/raw/nohup_*.log
experiments/**/data/raw/pull_*.log
experiments/**/data/raw/*smoke*.jsonl
experiments/**/data/raw/*gate*.jsonl
experiments/**/data/raw/*probe*.jsonl
experiments/**/data/raw/*.bak*
experiments/**/data/raw/*before_*.jsonl
experiments/**/data/raw/*removed_*.jsonl
experiments/**/data/raw/*pre_sleep_prune*.jsonl
experiments/**/data/raw/bbh_discarded_*/
experiments/**/data/raw/bbh_sleep_checkpoint_*/

# Regenerable diagnostic / smoke derived artifacts
experiments/**/results/processed/*smoke*
experiments/**/results/processed/*dryrun*
experiments/**/results/processed/*sanity*
experiments/**/results/processed/*retry_gate*
experiments/**/results/figures-smoke/
